+# I/O library, and "flatten class" of a missing cell aborts netgen.)
 flatten class "\$circuit1 gf180mcu_ocd_io__vdd"
 flatten class "\$circuit2 gf180mcu_ocd_io__vdd"
 flatten class "\$circuit1 gf180mcu_ocd_io__dvdd"
